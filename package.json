{
  "name": "rubcube-backend",
  "version": "2.0.0",
  "description": "API REST que interpreta logs do Quake 3 (exercício técnico de backend)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrennok/RubcubeBackend.git"
  },
  "keywords": [
    "quake",
    "log-parser",
    "node",
    "typescript",
    "express"
  ],
  "author": "lucasrennok",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lucasrennok/RubcubeBackend/issues"
  },
  "homepage": "https://github.com/lucasrennok/RubcubeBackend#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
